match (d) {
    Declaration.Enum { e }: {
        return compileEnum(e)
    },
    Declaration.Import { imp }: {
        return compileImport(imp)
    },
    Declaration.Struct { s }: {
        return compileStruct(s)
    },
    Declaration.Function { f }: {
        return compileFunction(f)
    },
}
